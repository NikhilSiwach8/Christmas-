diff -ruN '--exclude=node_modules' a/packages/components-ui-pixi/src/theme.svelte.ts packages/components-ui-pixi/src/theme.svelte.ts
--- a/packages/components-ui-pixi/src/theme.svelte.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/packages/components-ui-pixi/src/theme.svelte.ts	2026-11-26 11:44:03.016112013 +0000
@@ -0,0 +1,22 @@
+// Themeable look of the shared pixi UI (labels, panels, buttons). Defaults reproduce the original black/white look.
+export const uiTheme = $state({
+	fontFamily: 'proxima-nova',
+	fontWeight: '600' as '400' | '500' | '600' | '700' | '800' | '900',
+	letterSpacing: 0,
+	text: 0xffffff,
+	panelFill: 0x000000,
+	panelAlpha: 1,
+	panelBorder: 0xffffff,
+	panelBorderWidth: 0,
+	buttonFill: 0x000000,
+	buttonText: 0xffffff,
+	buttonBorder: 0xffffff,
+	buttonBorderWidth: 0,
+	buttonFillLight: 0xffffff,
+	buttonTextLight: 0x000000,
+	buttonDisabled: 0xaaaaaa,
+	accent: 0xffffff,
+	spinFill: 0x000000,
+});
+
+export const setUiTheme = (theme: Partial<typeof uiTheme>) => Object.assign(uiTheme, theme);
